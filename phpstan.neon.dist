# The WordPress extension (szepeviktor/phpstan-wordpress) is loaded by phpstan/extension-installer.
parameters:
	level: 6
	paths:
		- axle-staging-guard.php
		- uninstall.php
		- src
	dynamicConstantNames:
		- AXLE_STAGING_GUARD_MAIL_MODE
		- AXLE_STAGING_GUARD_REDIRECT_TO
		- AXLE_STAGING_GUARD_ALLOWLIST
		- AXLE_STAGING_GUARD_KEEP_BODIES
		- AXLE_STAGING_GUARD_NOINDEX
		- AXLE_STAGING_GUARD_LOG_DAYS
		- AXLE_STAGING_GUARD_PRODUCTION_HOSTS
	scanFiles:
		- vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
	bootstrapFiles:
		- tests/phpstan-bootstrap.php
	ignoreErrors:
		# WordPress passes untyped arrays everywhere (hook arguments, options, REST data).
		- identifier: missingType.iterableValue
